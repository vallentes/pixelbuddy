{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PixelBuddy",
  "version": "1.0.0",
  "identifier": "app.pixelbuddy.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "PixelBuddy",
        "url": "index.html",
        "width": 1000,
        "height": 700,
        "minWidth": 780,
        "minHeight": 560,
        "visible": false,
        "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost http://pbmodel.localhost pbmodel: https://huggingface.co https://*.huggingface.co https://*.hf.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg"
    ],
    "publisher": "PixelBuddy",
    "copyright": "Copyright (c) 2026 PixelBuddy",
    "category": "Entertainment",
    "shortDescription": "Pixel-art desktop pets",
    "longDescription": "Five original pixel-art pets that walk along your screen, react to your mouse and your Twitch stream.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        },
        "appPosition": {
          "x": 160,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 440,
          "y": 190
        }
      }
    }
  }
}
